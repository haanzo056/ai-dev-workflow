ANTHROPIC_API_KEY=

# pr-reviewer
REVIEWER_MODEL=claude-sonnet-5
REVIEWER_PROMPT_VERSION=v3
# low | medium | high
REVIEWER_EFFORT=medium
REVIEWER_TOKEN_BUDGET=200000
REVIEWER_MAX_TOKENS_PER_CHUNK=12000
REVIEWER_MIN_CONFIDENCE=0.6
REVIEWER_MAX_COMMENTS=12
# REVIEWER_INCLUDE_NITS=1
# only needed for --pr / --post
GITHUB_TOKEN=

# docs-chat
DOCS_CHAT_MODEL=claude-sonnet-5
DOCS_CHAT_PROMPT_VERSION=v2
# local (no network, keyword-ish) or voyage
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# defaults to apps/docs-chat/data/docs.db
# DOCS_DB_PATH=

# evals
EVAL_JUDGE_MODEL=claude-sonnet-5
